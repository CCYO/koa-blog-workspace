server {
    listen 80;
    listen [::]:80;

    server_name dev-koa-blog.ccyo.work;

    ##### ##### ##### ##### #####
    # managed by Certbot
    if ($host = dev-koa-blog.ccyo.work) {
        return 301 https://$host$request_uri;
    }

    return 404;
    ##### ##### ##### ##### #####
}

server {
    ##### ##### ##### ##### #####
    # managed by Certbot
    listen [::]:443 ssl; #ipv6only=on;
    listen 443 ssl;
    ##### ##### ##### ##### #####

    server_name dev-koa-blog.ccyo.work;

    # 指定log存放處
    # _main: 自定義的log_format(格式定義在/etc/nginx/nginx.config ) 
    access_log /var/log/nginx/dev/koa-blog/access.log _main;
    error_log /var/log/nginx/dev/koa-blog/error.log;

    ##### ##### ##### ##### #####
    # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
    ssl_certificate /etc/letsencrypt/live/_ccyo.work/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/_ccyo.work/privkey.pem;

    ##### ##### ##### ##### #####

    # 限制請求體大小
    client_max_body_size 10M;

    # 錯誤頁處理
    include /home/ccy015ccy/koa-blog/server/_config/nginx/include/error.nginx;

    #針對HMR
    location /__webpack_hmr {
        # HMR 請求直接轉發給 DevServer
        proxy_pass http://localhost:8080;
        # 保留原始 Host 頭
        # 讓後端 HMR server 能獲得原始主機資訊（有些 dev server 會依此處理 CORS 或其他驗證）
        proxy_set_header Host $host;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        # 升級為 WebSocket
        proxy_set_header Connection "upgrade";
        # 確保 WebSocket 長連接不超時
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        # 避免 Nginx 緩衝導致 HMR 更新延遲
        proxy_buffering off;
    }

    location /ws {
        proxy_pass http://localhost:8080;
        proxy_set_header Host $host;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        # @@確認要不要添加
        proxy_buffering off;
    }
    # Gemini
    location /public/ {
        # 將所有 /public/ 開頭的請求轉發給 Webpack DevServer
        # 注意這裡的 proxy_pass 後面也需要加上 /public/，
        # 以確保 DevServer 收到正確的內部路徑請求。
        proxy_pass http://localhost:8080/public/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    location /ccyo_ws {
        proxy_pass http://localhost:3000;
        proxy_set_header Host $host;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        # @@確認要不要添加
        proxy_buffering off;
    }

    # 其他所有請求轉發給 Node.js 後端
    location / {
        proxy_pass http://localhost:3000;
        proxy_set_header Host $host;
        proxy_read_timeout 36000s;
        proxy_send_timeout 36000s;

        # Gemini
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }















































































