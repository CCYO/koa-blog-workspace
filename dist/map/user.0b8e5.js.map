export default "<% let { otherComments } = comment %>\n<% let count = otherComments.commenters.length %>\n<% let others = otherComments.commenters.map(({ nickname }) => nickname) %>\n<% let other_nicknames = count > 1 ? others.slice(0, 2).join(\",\") + (count > 2 ? `與其他${count - 2}人` : \"\" + `，都`) : count === 1 ? others[0] : comment.commenter.nickname; %>\n<% let nicknames = count > 1 ? `${comment.commenter.nickname} ${other_nicknames}` :  other_nicknames %>\n<% let query = confirm ? \"\" : `?type=3&id=${id}` %>\n<li class=\"dropdown-item  position-relative news-item transition-bg\" <%= confirm ? `style=\"\"` : `style=\"background-color: rgb(120 180 255);\"` %>>\n  <a href=\"/api/news/msgReceiver/<%= id %>\" class=\"stretched-link text-wrap\" title=\"<%= new Date(updatedAt).toLocaleString() %>\">\n    <div class=\"news-item-content\">\n      <span><%= nicknames %>在「<%= comment.article.title %>」留言囉！</span>\n    </div>\n  </a>\n  <p><%= timestamp %></p>\n</li>";