export default "<li class=\"nav-item d-none d-sm-block <%= active === 'square' ? 'active' : '' %>\">\n  <a class=\"nav-link\" href=\"/square\">文章廣場</a>\n</li>\n<li style=\"flex-grow: 1;\"></li>\n<!--下拉選單-->\n<li class=\"nav-item dropdown\">\n  <a class=\"nav-link dropdown-toggle\" href=\"#\" id=\"newsDropdown\" role=\"button\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" aria-expanded=\"false\">通知\n    <span class=\"badge rounded-pill bg-danger news-count\"></span>\n    <span class=\"badge rounded-pill bg-danger new-news-count\"></span>\n  </a>\n  <!-- 通知列表 -->\n  <ul class=\"dropdown-menu dropdown-menu-end\" aria-labelledby=\"navbarDropdown\" id=\"newsList\">\n    <!-- 新通知標題 -->\n    <li class=\"dropdown-item\" style=\"display: none;\" id=\"unconfirm-news-title\">新通知</li>\n    <!-- 先前通知的標頭 -->\n    <li class=\"dropdown-item\" style=\"display: none;\" id=\"confirm-news-title\">先前的通知</li>\n    <li id=\"readMore\">\n      <button class=\"dropdown-item link-primary\" type=\"button\">讀取更多</button>\n    </li>\n    <li class=\"dropdown-item\" id=\"noNews\">\n      <span>沒有更多了</span>\n    </li>\n  </ul>\n</li>";