export default "<!-- 傳入 comment -->\n<% let G_PAGE = SELECTOR.BLOG %>\n<div class=\"<%= G_PAGE.CLASS.COMMENT_ITEM_CONTENT %>\" id=\"comment_<%= id %>\">\n  <% if (deletedAt || !html) { %>\n  <div>\n    <p>此留言已刪除</p>\n  </div>\n  <div>\n    By<a href=\"/other/<%= commenter.id %>\"><%= commenter.nickname %></a> 於 <%= time %> 刪除\n  </div>\n  <% } else { %>\n  <%= html %>\n  <div>\n    By<a href=\"/other/<%= commenter.id %>\"><%= commenter.nickname %></a> 於 <%= time %> 發佈\n    <button class=\"btn btn-outline-primary btn-sm\">回覆</button>\n    <button style=\"display: none;\" class=\"btn btn-outline-danger btn-sm\" <%= `data-${G_PAGE.DATASET.KEY.REMOVE_COMMENT}=${id}` %>>刪除</button>\n  </div>\n  <% } %>\n</div>";