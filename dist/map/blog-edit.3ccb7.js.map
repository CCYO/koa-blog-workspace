export default "<!-- 傳入 user -->\n<% let G_PAGE = SELECTOR.USER %>\n<li class=\"list-group-item\" data-<%= G_PAGE.DATASET.KEY.USER_ID %>=\"<%= user.id %>\">\n  <div class=\"ratio ratio-1x1\">\n    <img src=\"<%= user.avatar %>\" alt=\"\">\n  </div>\n  <div class=\"text-truncate\">\n    <a href=\"/other/<%= user.id %>\" class=\"stretched-link\" draggable=\"false\">\n      <%= user.nickname %>\n    </a>\n  </div>\n</li>";