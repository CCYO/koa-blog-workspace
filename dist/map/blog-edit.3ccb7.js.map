export default "<!-- 新通知 of fans -->\n<% let query = confirm ? \"\" : `?type=1&id=${id}` %>\n<li class=\"dropdown-item position-relative news-item transition-bg\" <%= confirm ?`style=\"\"` : `style=\"background-color: rgb(120 180 255);\"` %>>\n  <a href=\"/api/news/idolFans/<%= id %>\" class=\"stretched-link text-wrap\" title=\"<%= new Date(updatedAt).toLocaleString() %>\">\n    <div class=\"news-item-content\">\n      <span><%= fans.nickname %>追蹤你囉！</span>\n    </div>\n  </a>\n  <p><%= timestamp %></p>\n</li>";