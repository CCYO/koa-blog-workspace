export default "<% let noRedir = [\"login\",\"register\"].some( page => page === active) %>\n<li class=\"nav-item d-none d-sm-block  <%= active === 'square' ? 'active' : '' %>\">\n  <a class=\"nav-link\" href=\"/square\">文章廣場</a>\n</li>\n<li style=\"flex-grow: 1;\"></li>\n<li class=\"nav-item  <%= active === 'login' ? 'active' : '' %>\">\n  <a class=\"nav-link nav-tab\" href=\"<%= noRedir ? '#' : '/login' %>\" data-my-tab=\"#login\">登入</a>\n</li>\n<li class=\"nav-item  <%= active === 'register' ? 'active' : '' %>\">\n  <a class=\"nav-link nav-tab\" href=\"<%= noRedir ? '#' : '/register' %>\" data-my-tab=\"#register\">註冊</a>\n</li>";